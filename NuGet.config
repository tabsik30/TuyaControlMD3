<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <packageSources>
        <clear />
        <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
        <!-- Keep the empty source available in fresh clones for builds against unreleased SDK versions. -->
        <add key="local" value="./local-feed" />
    </packageSources>
</configuration>
